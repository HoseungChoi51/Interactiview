# --- 필수 ---
# 베타 테스터에게 나눠줄 초대 코드 (초대 링크: https://<도메인>/join?code=이값)
INVITE_CODE=study2026
# 관리 페이지 접속 키 (https://<도메인>/admin?key=이값)
ADMIN_KEY=change-me
# 인터뷰이 답변 링크 서명용 비밀값 (아무 긴 문자열)
ANSWER_SECRET=change-me-to-a-long-random-string

# --- Claude API (없으면 데모 모드: 키워드로 원문만 찾아 보여줌) ---
ANTHROPIC_API_KEY=

# --- Supabase (비워두면 이 컴퓨터의 SQLite 파일에 저장. Vercel 로 배포할 때만 필요) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 메일 (없으면 주간 메일 내용을 응답으로만 보여줌) ---
RESEND_API_KEY=
MAIL_FROM=인터뷰집 <noreply@example.com>
ADMIN_EMAIL=
# 인터뷰이 메일: 슬러그:메일, 쉼표로 구분
INTERVIEWEE_EMAILS=sample-jiwoo:jiwoo@example.com,sample-minho:minho@example.com
# Vercel 예약 작업 인증용 (Vercel 프로젝트 환경변수에 같은 값)
CRON_SECRET=
# 사이트 주소 (메일 속 링크에 사용)
SITE_URL=http://localhost:3000

# --- 선택 ---
# 한 사람이 하루에 할 수 있는 질문 수
DAILY_QUESTION_LIMIT=40
# 저장 파일 위치를 바꾸려면 (기본 .data/interactiview.db)
# DB_FILE=
